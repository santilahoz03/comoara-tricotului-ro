# .env.example — todas las claves de todos los kits de ZEA
#
# Copiá este archivo como .env en la raíz de la carpeta de tu negocio y completá SOLO las de los kits que uses
# (qué clave usa cada kit: sops/que-necesita-cada-kit.md). Con "Solo Cazar" queda vacío y está bien.
# Nunca subas el .env a GitHub, nunca lo pegues en un chat, en una página pública ni en la comunidad.
# Una clave vacía = "no la uso todavía". El script tools/verificar_stack.py la marca como VACÍA y sigue.
#
# Cuándo necesitás cada una: ver sops/claves-paso-a-paso.md

# ── GENERACIÓN (imagen, video, voz) ─────────────────────────────────────────────
KIE_API_KEY=                 # kie.ai → API Keys. Imágenes (gpt-image-2), video (Veo, Kling), ebooks. Kits 02, 03, 05, 06
GEMINI_API_KEY=              # aistudio.google.com/apikey. Tiene que empezar con "AIza". TTS gratis y análisis de video
ELEVENLABS_API_KEY=          # elevenlabs.io → Developers → API Keys. Voces premium (opcional)
DREAMAPI_KEY=                # DreamAPI (api.newportai.com). Avatar que habla para VSL post-pago (kit embudo post-pago)

# ── RÉPLICA DE VIDEO ────────────────────────────────────────────────────────────
VMAKE_AK=                    # vmake.ai/developers. Access Key (+ SDK de Python de ahí). Solo tarea videoscreenclear (kit ads)
VMAKE_SK=                    # vmake.ai → Developers. Secret Key

# ── COBRO ───────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=           # Stripe → Developers → API keys. Recomendado: clave RESTRINGIDA (rk_...) de solo lectura
                             # + permiso de reembolsos solo si vas a usar el kit de soporte
WHOP_API_KEY=                # Whop → Developer → API keys (opcional, solo si cobrás con Whop)
MERCADOPAGO_ACCESS_TOKEN=    # Mercado Pago → Tus integraciones → Credenciales de producción (opcional, Argentina)

# ── TRACKING Y LANZAMIENTO ──────────────────────────────────────────────────────
UTMIFY_MCP_TOKEN=            # Utmify → Integraciones → MCP. Es el token que va dentro de la URL del MCP. Es SECRETO
META_AD_ACCOUNT_ID=          # act_XXXXXXXXX de tu cuenta publicitaria (no es secreto, pero es tuyo: no lo publiques)
META_PIXEL_ID=               # ID de tu píxel/dataset de Meta (idem)
# AdsUploader NO usa clave en el .env: se conecta con `ads login` (CLI) y con el MCP remoto (ver sops/conectores-y-permisos.md)

# ── HOSTING Y BACKEND ───────────────────────────────────────────────────────────
PANDA_API_KEY=               # Panda Video → Configuraciones → API. Hosting de las VSL del backend
SUPABASE_URL=                # Supabase → Project Settings → API (solo si hacés entregables con IA / proxy de claves)
SUPABASE_SERVICE_ROLE_KEY=   # Supabase → Project Settings → API → service_role. NUNCA en frontend
# GitHub (páginas estáticas) NO usa clave en el .env: se conecta con `gh auth login`

# ── NOTIFICACIONES ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # Telegram → @BotFather → /newbot. Para que tus rutinas te avisen
TELEGRAM_CHAT_ID=            # Tu chat ID (el script te ayuda a sacarlo: ver sops/claves-paso-a-paso.md)

# ── UMBRALES (no son claves) ────────────────────────────────────────────────────
KIE_CREDITOS_MINIMOS=500     # Si el saldo de kie.ai baja de esto, la rutina semanal te avisa por Telegram
TOPE_GASTO_SIN_AVISO_USD=5   # Arriba de este gasto en generación, Claude te pide OK antes
